[Script]
http-request ^https:\/\/api\.getmoshi\.app\/api\/(?:v1\/licenses\/(?:me|activate|[^\/]+\/devices)|ota\/manifest)(?:[\/?#]|$) script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/moshi/moshi-pro.js, requires-body=false, timeout=30, tag=moshi-pro

